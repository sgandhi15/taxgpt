# Response headers for the static files (Cloudflare Workers static assets).
# The /chat, /config and /health routes are answered by the Worker and don't use this file.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Only our own files may run. challenges.cloudflare.com is the optional Turnstile bot check.
  # No inline scripts or styles are allowed anywhere.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The fonts only change when their npm package is upgraded, so browsers can keep
# them for a week. The page, styles and our scripts keep the default
# (checked on every visit), so changes show up straight away.
# Paths here are full request paths, including the /taxgpt prefix.
/taxgpt/vendor/*
  Cache-Control: public, max-age=604800
