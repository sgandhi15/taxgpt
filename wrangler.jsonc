{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taxgpt",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Served at sarthak.page/taxgpt, next to the other projects on that domain. No
  // workers.dev address. Files in public/ are served under /taxgpt/; everything
  // else under /taxgpt reaches the Worker (see BASE_PATH in src/index.ts).
  "workers_dev": false,
  "routes": [{ "pattern": "sarthak.page/taxgpt*", "zone_name": "sarthak.page" }],
  "assets": { "directory": "./public", "base_path": "/taxgpt" },
  // Copies the fonts into public/vendor/fonts/ before every dev run and deploy.
  "build": { "command": "npm run vendor" },

  // Embeddings (Workers AI) and vector search (Vectorize). Neither can be simulated
  // locally, so `wrangler dev` talks to the real ones.
  "ai": { "binding": "AI", "remote": true },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "taxgpt", "remote": true }],

  // Per-visitor limit: 5 questions a minute, keyed by IP address.
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Counts questions per day across all visitors (see DAILY_QUESTION_LIMIT).
  "durable_objects": { "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }],

  "vars": {
    "CLAUDE_MODEL": "claude-haiku-5-5",
    "CLAUDE_EFFORT": "medium",
    "DAILY_QUESTION_LIMIT": "500",
    // Optional bot check. Set this and the TURNSTILE_SECRET_KEY secret to turn it on.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGPW1N3LLkgJz5BS"
  }

  // Secrets (set with `wrangler secret put <NAME>`; locally in .dev.vars):
  //   ANTHROPIC_API_KEY       required
  //   TURNSTILE_SECRET_KEY    optional
}
